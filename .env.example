# Required — identifies your app in logs and App Insights Application Map
OTEL_SERVICE_NAME=property-calculator

# Optional — log level filter (DEBUG, INFO, WARNING, ERROR, CRITICAL). Default: INFO
# LOG_LEVEL=INFO

# Optional — set to route logs to Azure Monitor instead of local .logs/
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Rentcast API (used by Property-Prompt.md bash commands)
RENTCAST_API_KEY=your_rentcast_api_key_here

# Azure OpenAI (used by Property Parser backend)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Google Sheets (service account JSON — paste full JSON string)
GOOGLE_SERVICE_ACCOUNT={}
GOOGLE_SHEET_ID=1dVf1UShQry4nDvM3HbqM9ts0ltbKnruEDKd6lZ_xAMg

# Apify SuperScraper (used for JS-rendered pages like TheMLS)
APIFY_API_TOKEN=your_apify_api_token_here

# Bright Data Scraping Browser (used for Cloudflare-protected sites like LoopNet)
BRIGHTDATA_BROWSER_WSS=wss://brd-customer-XXXX-zone-XXXX:PASSWORD@brd.superproxy.io:9222
